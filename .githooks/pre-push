#!/usr/bin/env bash
#
# pre-push — corre el gate ANTES de que nada salga del portátil.
#
# Por qué existe: la regla 7 de LEARNINGS ("antes de `git push`, `preflight` sobre el árbol
# final") es la que más se ha quebrado, y siempre por lo mismo — se lee al empezar la tarea y
# el disparador salta horas después, cuando ya hay prisa y "cuatro gates verdes" parecen
# suficientes. Una regla que depende de acordarse en el momento exacto no se cumple sola; una
# que ejecuta el ordenador, sí. Es la doctrina del propio repo: lo mecanizable va a un gate,
# no a un párrafo (README, «Regla de la casa»).
#
# Corre `preflight:scope`, que mira QUÉ tocaste y ajusta la cadena — y que imprime siempre lo
# que deja fuera, así que el verde nunca es mudo. Si el árbol ya lleva la marca de un carril en
# verde (`scripts/preflight-mark.mjs --check`), sube sin repetirla.
#
# Salida de emergencia:  SKIP_PREFLIGHT=1 git push
# Úsala sabiendo que te saltas el gate; queda dicho en pantalla.

set -euo pipefail

# FRENO DE LA REESCRITURA DEL 15 DE OCTUBRE DE 2026 (DD-207, D3 de docs/AUDIT-INGENIERIA-2026-10.md).
# Estos seis commits llevaban teléfonos de la extracción de la app real y se quitaron de TODA la historia de
# GitHub. Una rama vieja que se empuje tal cual los devuelve, y eso no es un fallo de calidad: por eso va ANTES de
# `SKIP_PREFLIGHT`, que no lo salta. Solo corre si el commit existe en tu copia (un clon nuevo no lo tiene).
# `SC_COMMITS_RETIRADOS` lo sustituye en los tests; vacío, lo apaga.
# git pasa las refs del push por stdin, y se leen UNA VEZ: dos bucles leyendo del mismo tubo dejaban ciego al
# segundo (el primero se lo comía entero). Con here-string, además, el `while` no corre en subshell.
REFS_DEL_PUSH="$(cat)"
COMMITS_RETIRADOS="${SC_COMMITS_RETIRADOS-ac7a2168d22191f28b4716d45bf13f941dfdfa19 7cedc8f8fe6d5c8965026daff0150e650cdbeedd 49ad3824435868c2bc166532ef7531d39f1201dd 153e187a3bfdc5c1b44ba7378c05c319cd6e11d2 bc07c4d7e6a9497290a493b5f63455925fe9036e cbfe38ada289c1c533fb543fe1d91f9adaf54330}"
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
  for retirado in $COMMITS_RETIRADOS; do
    git cat-file -e "$retirado^{commit}" 2>/dev/null || continue
    if git merge-base --is-ancestor "$retirado" "$local_sha" 2>/dev/null; then
      printf '\n\033[31m✘ pre-push: esta rama lleva commits de antes de la reescritura del historial (15 de octubre de 2026).\033[0m\n'
      printf '  Llevaban teléfonos de la extracción de la app real; subirla los devuelve a GitHub. Rebásala sobre el main nuevo:\n'
      printf '    git fetch origin && git rebase --onto origin/main $(git merge-base <rama> a3f1876e) <rama>\n'
      printf '  SKIP_PREFLIGHT no salta esto: no es un gate de calidad, es una fuga de datos.\n\n'
      exit 1
    fi
  done
done <<< "$REFS_DEL_PUSH"

if [ "${SKIP_PREFLIGHT:-0}" = "1" ]; then
  printf '\n\033[33m⚠ preflight SALTADO (SKIP_PREFLIGHT=1). El CI es ahora tu única red.\033[0m\n\n'
  exit 0
fi

# nvm si está: este repo pide Node 22 y un git hook no hereda el shell interactivo
# (ver LEARNINGS, «tres node y un PATH que se mueve»).
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  # shellcheck disable=SC1091
  . "$NVM_DIR/nvm.sh" >/dev/null 2>&1 || true
  nvm use >/dev/null 2>&1 || true
fi

# Congelar una versión (`docs/PROTOTIPOS.md`, DD-56) sube DOS PUNTEROS: la etiqueta
# `proto/<TICKET>` y la rama `proto/<ticket>`. Ninguna de las dos introduce código: apuntan a un
# commit que YA está en `origin/main`, o sea que YA pasó su preflight y su CI cuando entró. Correr
# la cadena entera otra vez son ~8 minutos por publicar un enlace, y un trámite que cuesta eso
# no se hace: se acaba usando `SKIP_PREFLIGHT=1`, que es peor, porque desactiva el gate de verdad.
#
# La excepción es ESTRECHA a propósito y se comprueba, no se confía: solo si TODAS las refs de
# este push son `proto/*` Y su commit es antepasado de `origin/main`. Un `proto/loquesea` que
# apunte a algo que no esté en main NO pasa por aquí, así que esto no es una puerta trasera para
# subir código con un nombre bonito.
# git pasa las refs del push por stdin, y se leen UNA VEZ: dos bucles leyendo del mismo tubo
# dejaban ciego al segundo (el primero se lo comía entero). Con here-string, además, el `while`
# no corre en subshell y las variables sobreviven.

# BORRAR una rama remota no sube código: el sha local es todo ceros y no hay árbol que verificar.
# Y AGENTS manda limpiar la rama en cuanto el PR se funde, «sin preguntar». Con el gate delante,
# esa limpieza costaba ~8 minutos de cadena por no subir NADA, así que o no se hace o se hace con
# `SKIP_PREFLIGHT=1`, que apaga el gate de verdad para la próxima vez. Se comprueba, no se confía:
# solo si TODAS las refs del push son borrados. (Medido el 2026-09-10 borrando una rama fundida.)
if [ "${SKIP_BORRADO_FASTPATH:-0}" != "1" ]; then
  solo_borrados=1
  hay_refs=0
  while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    hay_refs=1
    case "$local_sha" in
      *[!0]*) solo_borrados=0 ;;
    esac
  done <<< "$REFS_DEL_PUSH"

  if [ "$hay_refs" = "1" ] && [ "$solo_borrados" = "1" ]; then
    printf '\n\033[32m✓ borrado de rama: no sube código, no hay árbol que verificar\033[0m\n\n'
    exit 0
  fi
fi

if [ "${SKIP_PROTO_FASTPATH:-0}" != "1" ]; then
  git fetch --quiet origin main 2>/dev/null || true
  solo_proto=1
  hay_refs=0
  while read -r _local_ref local_sha remote_ref _remote_sha; do
    [ -z "${remote_ref:-}" ] && continue
    hay_refs=1
    case "$remote_ref" in
      refs/tags/proto/* | refs/heads/proto/*)
        commit=$(git rev-parse --quiet --verify "${local_sha}^{commit}" 2>/dev/null || true)
        if [ -z "$commit" ] || ! git merge-base --is-ancestor "$commit" origin/main 2>/dev/null; then
          solo_proto=0
        fi
        ;;
      *) solo_proto=0 ;;
    esac
  done <<< "$REFS_DEL_PUSH"

  if [ "$hay_refs" = "1" ] && [ "$solo_proto" = "1" ]; then
    printf '\n\033[32m✓ versión congelada: punteros a un commit que ya está en main\033[0m\n'
    printf '  Sin preflight: no hay código nuevo que verificar.\n\n'
    exit 0
  fi
fi

# A partir de aquí se ejecuta CÓDIGO DEL REPO (la cadena entera, con sus tests). Y git, cuando
# llama a un hook, EXPORTA `GIT_DIR` apuntando al repositorio de verdad: cualquier `git` que
# lance un script de esa cadena cae sobre él, ignorando su propio `cwd`. Un `git init --bare` en
# un repo temporal de un test dejó así el repositorio principal marcado como bare, y con eso TODAS
# las sesiones abiertas se quedaron sin árbol de trabajo («fatal: this operation must be run in a
# work tree»). Se limpia el entorno antes de dar paso: el gate no tiene por qué heredar el repo.
# (Medido el 2026-09-11, dos veces, las dos borrando una rama ya fundida.)
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX GIT_QUARANTINE_PATH

printf '\n\033[1m▶ pre-push: gate antes de subir\033[0m  (SKIP_PREFLIGHT=1 para saltarlo)\n\n'

# Si ESTE árbol ya pasó un carril (marca `.preflight-ok`, tree id == HEAD), no se repite la
# cadena: el verde ya está medido y repetirlo son ~8 min de nada (2026-09-02, DD-47; DD-60 sacó los e2e).
if node scripts/preflight-mark.mjs --check; then
  printf '\033[32m✓ árbol ya verificado — subiendo sin repetir la cadena\033[0m\n\n'
  exit 0
fi

if npm run preflight:scope --silent -- --run; then
  printf '\n\033[32m✓ gate en verde — subiendo\033[0m\n\n'
  exit 0
fi

printf '\n\033[31m✗ el gate ha fallado: el push se queda aquí.\033[0m\n'
printf '  Arréglalo y repite, o SKIP_PREFLIGHT=1 git push si sabes lo que haces.\n\n'
exit 1
