# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log
yarn-error.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Miscellaneous
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings

# Playwright e2e (artefactos de cada run — no se versionan)
/test-results/
/playwright-report/
/blob-report/

# System files
.DS_Store
Thumbs.db

# npm registry auth (publish) — never commit tokens
.npmrc

# Variables de entorno con secretos — nunca al repo (es público)
.env
.env.local
.env.*.local

# Output del Theme Designer (plugin primeui-figma-plugin-v4): preset PrimeNG que NO
# usamos (generamos el nuestro desde el DTCG). El workflow tokens-sync lo descarta.
.theme-designer/

# Sesiones de Playwright para medir el original: son credenciales vivas.
.auth/

# Bundle del original cacheado para el censo de la Fase 3.
.cache/

# Capturas de trabajo de las comparaciones visuales (web ↔ Figma ↔ referencias).
# Son material de una sesión, no entregable: pesan MB y no aportan histórico.
# `/tmp` de arriba no las cubre — el nombre empieza por punto.
/.tmp-captures/

# Marca de "preflight en verde sobre este árbol" (scripts/preflight-mark.mjs); la lee el hook al pushear.
.preflight-ok
